Changes made in makefiles to work with nasm.

--- a/C/7zip_gcc_c.mak
+++ b/C/7zip_gcc_c.mak
@@ -1,8 +1,7 @@
 
 MY_ARCH_2 = $(MY_ARCH)
 
-MY_ASM = jwasm
-MY_ASM = asmc
+MY_ASM = nasm
 
 ifndef RC
 #RC=windres.exe --target=pe-x86-64
@@ -127,14 +126,14 @@ endif
 
 
 ifdef IS_X64
-AFLAGS_ABI = -elf64 -DABI_LINUX
+AFLAGS_ABI = -felf64
 else
-AFLAGS_ABI = -elf -DABI_LINUX -DABI_CDECL
+AFLAGS_ABI = -felf32
 # -DABI_CDECL
 # -DABI_LINUX
 # -DABI_CDECL
 endif
-AFLAGS = $(AFLAGS_ABI) -Fo$(O)/
+AFLAGS = $(AFLAGS_ABI) -I$(<D) -o $(O)/$(*F).o
 
 C_WARN_FLAGS =
 
@@ -146,7 +145,10 @@ STATIC_TARGET=$(PROGPATH_STATIC)
 endif
 
 
-all: $(O) $(PROGPATH) $(STATIC_TARGET)
+all: $(PROGPATH) $(STATIC_TARGET)
+
+# we need $(O) as order-only-prerequisites:
+$(OBJS): | $(O)
 
 $(O):
 	$(MY_MKDIR) $(O)
--- a/CPP/7zip/7zip_gcc.mak
+++ b/CPP/7zip/7zip_gcc.mak
@@ -7,10 +7,7 @@
 
 MY_ARCH_2 = $(MY_ARCH)
 
-MY_ASM = asmc
-ifdef USE_JWASM
-MY_ASM = jwasm
-endif
+MY_ASM = nasm
 
 ifndef RC
 RC=windres.exe --target=pe-x86-64
@@ -174,26 +171,26 @@ CFLAGS = $(MY_ARCH_2) $(LOCAL_FLAGS) $(CFLAGS_BASE2) $(CFLAGS_BASE) $(FLAGS_FLTO
 ifdef IS_MINGW
 
 ifdef IS_X64
-AFLAGS_ABI = -win64
+AFLAGS_ABI = -fwin64
 else
-AFLAGS_ABI = -coff -DABI_CDECL
+AFLAGS_ABI = -fwin32 -DABI_CDECL
 # -DABI_CDECL
 # -DABI_LINUX
 # -DABI_CDECL
 endif
-AFLAGS = -nologo $(AFLAGS_ABI) -Fo$(O)/$(basename $(<F)).o
+AFLAGS = $(AFLAGS_ABI) -I$(<D) -o $(O)/$(*F).o
 
 else  # IS_MINGW
 
 ifdef IS_X64
-AFLAGS_ABI = -elf64 -DABI_LINUX
+AFLAGS_ABI = -felf64
 else
-AFLAGS_ABI = -elf -DABI_LINUX -DABI_CDECL
+AFLAGS_ABI = -felf32
 # -DABI_CDECL
 # -DABI_LINUX
 # -DABI_CDECL
 endif
-AFLAGS = -nologo $(AFLAGS_ABI) -Fo$(O)/
+AFLAGS = $(AFLAGS_ABI) -I$(<D) -o $(O)/$(*F).o
 
 endif  # IS_MINGW
 
@@ -249,6 +246,19 @@ endif
 
 endif
 
+ifndef IS_MINGW
+ifdef  USE_ASM
+ifdef  IS_X86
+ifndef IS_X64
+# link with -no-pie on 32 bit x86 architecture, otherwise we get this warning:
+# ld.bfd: _o/Sha1Opt.o: warning: relocation in read-only section `.text$00'
+# ld.bfd: warning: creating DT_TEXTREL in a PIE
+LFLAGS_NOPIE = -no-pie
+endif
+endif
+endif
+endif
+
 ifdef MACOS_MODE
 VERSION_HDR = ../../../../C/7zVersion.h
 SRC_VER_MAJOR := $(shell awk '/\#define MY_VER_MAJOR/ {print $$3}' $(VERSION_HDR))
@@ -257,7 +267,7 @@ SRC_VER := $(SRC_VER_MAJOR).$(SRC_VER_MINOR)
 LFLAGS_SRC_VER := -Wl,-source_version,$(SRC_VER)
 endif
 
-LFLAGS_ALL = $(LFLAGS_STRIP) $(MY_ARCH_2) $(LDFLAGS) $(FLAGS_FLTO) $(LD_arch) $(LFLAGS_NOEXECSTACK) $(LFLAGS_SRC_VER) $(OBJS) $(MY_LIBS) $(LIB2)
+LFLAGS_ALL = $(LFLAGS_STRIP) $(MY_ARCH_2) $(LDFLAGS) $(FLAGS_FLTO) $(LD_arch) $(LFLAGS_NOEXECSTACK) $(LFLAGS_NOPIE) $(LFLAGS_SRC_VER) $(OBJS) $(MY_LIBS) $(LIB2)
 
 # -s : GCC : Remove all symbol table and relocation information from the executable.
 # -s : CLANG : unsupported
@@ -1292,9 +1302,7 @@ $O/Sha256Opt.o: ../../../../Asm/x86/Sha256Opt.asm
 $O/Sort.o: ../../../../Asm/x86/Sort.asm
 	$(MY_ASM) $(AFLAGS) $<
 
-ifndef USE_JWASM
 USE_X86_ASM_AES=1
-endif
 
 else
 $O/7zCrcOpt.o: ../../../../C/7zCrcOpt.c
